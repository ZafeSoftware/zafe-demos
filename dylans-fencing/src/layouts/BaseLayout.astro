---
interface Props {
  title: string;
  description: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const baseUrl = 'https://zafe-demos.pages.dev/dylans-fencing';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{title}</title>
  <meta name="description" content={description}>
  
  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      "name": "Dylan's Fencing LLC",
      "telephone": "+1-210-260-5959",
      "email": "dylansfencing@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "9626 Wolf Point",
        "addressLocality": "San Antonio",
        "addressRegion": "TX",
        "postalCode": "78251",
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "City",
        "name": "San Antonio, TX"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "19:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/p/Dylans-Fencing-LLC-100093611084668/",
        "https://nextdoor.com/pages/goff-fencing-san-antonio-tx/"
      ],
      "image": `${baseUrl}/hero-1200.jpg`
    })} />
  )}
  
  <link rel="icon" type="image/svg+xml" href="/dylans-fencing/favicon.svg">
  <link rel="preload" href="/dylans-fencing/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  
  <style is:global>
    @font-face {
      font-family: 'Barlow Condensed';
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url('/dylans-fencing/fonts/barlow-condensed-latin-600-normal.woff2') format('woff2');
    }
    
    @font-face {
      font-family: 'Barlow Condensed';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('/dylans-fencing/fonts/barlow-condensed-latin-700-normal.woff2') format('woff2');
    }
    
    @font-face {
      font-family: 'Source Sans 3';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/dylans-fencing/fonts/source-sans-3-latin-400-normal.woff2') format('woff2');
    }
    
    @font-face {
      font-family: 'Source Sans 3';
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url('/dylans-fencing/fonts/source-sans-3-latin-600-normal.woff2') format('woff2');
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    :root {
      --color-bg: #F4F1EA;
      --color-dark: #303220;
      --color-charcoal: #505642;
      --color-cedar: #aa9269;
      --color-cedar-dark: #7d6a47;
      --color-cedar-light: #c4ad84;
      --color-text: #2a2a2a;
      --color-text-muted: #5a5a5a;
      --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
      --font-body: 'Source Sans 3', system-ui, -apple-system, sans-serif;
      --max-width: 1280px;
    }
    
    body {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      color: var(--color-text);
      background: var(--color-bg);
      -webkit-font-smoothing: antialiased;
    }
    
    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 700;
      line-height: 1.1;
      color: var(--color-dark);
    }
    
    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: -0.02em;
    }
    
    h2 {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      letter-spacing: -0.01em;
    }
    
    h3 {
      font-size: clamp(1.25rem, 3vw, 1.75rem);
    }
    
    img {
      max-width: 100%;
      height: auto;
      display: block;
    }
    
    a {
      color: inherit;
      text-decoration: none;
    }
    
    button, .btn {
      font-family: var(--font-display);
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    
    .section {
      padding: 4rem 0;
    }
    
    @media (min-width: 768px) {
      .section {
        padding: 6rem 0;
      }
    }
    
    @media (min-width: 1024px) {
      .section {
        padding: 8rem 0;
      }
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
