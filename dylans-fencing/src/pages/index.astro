---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.jpg';
import fencePortrait from '../assets/images/fence-line-portrait.jpg';
import fenceTree from '../assets/images/fence-tree-line.jpg';
import fenceDusk from '../assets/images/fence-dusk.jpg';
import fenceBackyard from '../assets/images/fence-backyard.jpg';
import fenceBrick from '../assets/images/fence-brick-house.jpg';
---

<BaseLayout 
  title="Dylan's Fencing LLC | Fence & Gate Contractor in San Antonio, TX"
  description="Professional wood fences and gates across San Antonio. Cedar privacy fencing, walk gates, fence staining, decks, painting, and pressure washing. Call (210) 260-5959 for a quote."
  isHome={true}
>
  <div class="demo-bar">
    <div class="container">
      <p><span class="demo-bar-full">Demo preview by </span><a href="https://zafe.dev" target="_blank" rel="noopener">Zafe</a><span class="demo-bar-full"> — a website concept for Dylan's Fencing LLC</span></p>
    </div>
  </div>

  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="./" class="wordmark">
          <div class="wordmark-main">DYLAN'S</div>
          <div class="wordmark-sub">FENCING LLC</div>
        </a>
        
        <nav class="nav" id="nav" aria-label="Main navigation">
          <a href="#services">Services</a>
          <a href="#projects">Projects</a>
          <a href="#process">How it works</a>
          <a href="#area">Service area</a>
          <a href="#quote" class="nav-cta">Get a quote</a>
        </nav>
        
        <div class="header-actions">
          <a href="tel:+12102605959" class="phone-link">(210) 260-5959</a>
          <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1>Wood fences and gates, built straight, across San Antonio.</h1>
          <p class="hero-support">Professional cedar privacy fencing and walk gates for San Antonio homes.</p>
          <div class="hero-actions">
            <a href="#quote" class="btn btn-primary">Get a fence quote</a>
            <a href="tel:+12102605959" class="btn btn-secondary">Call (210) 260-5959</a>
          </div>
          <p class="hero-proof">
            <a href="https://nextdoor.com/pages/goff-fencing-san-antonio-tx/" target="_blank" rel="noopener">77 Faves from neighbors on Nextdoor</a>
          </p>
        </div>
        <div class="hero-image">
          <picture>
            <source 
              type="image/avif"
              srcset="/_astro/hero_480.avif 480w, /_astro/hero_800.avif 800w, /_astro/hero_1200.avif 1200w"
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <source 
              type="image/webp"
              srcset="/_astro/hero_480.webp 480w, /_astro/hero_800.webp 800w, /_astro/hero_1200.webp 1200w"
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <Image 
              src={heroImg}
              alt="Wood privacy fence with walk gate across a San Antonio backyard"
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              quality={85}
            />
          </picture>
        </div>
      </div>
      <div class="hero-divider">
        <div class="picket-line">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
    </section>

    <section class="section services" id="services">
      <div class="container">
        <h2>Services</h2>
        <p class="services-intro">Professional fencing and property services for San Antonio homes and businesses.</p>
        
        <div class="services-grid">
          <div class="service service-featured">
            <div class="service-content">
              <div class="service-icon">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                  <rect x="4" y="8" width="2" height="32" fill="currentColor"/>
                  <rect x="11" y="8" width="2" height="32" fill="currentColor"/>
                  <rect x="18" y="8" width="2" height="32" fill="currentColor"/>
                  <rect x="25" y="8" width="2" height="32" fill="currentColor"/>
                  <rect x="32" y="8" width="2" height="32" fill="currentColor"/>
                  <rect x="39" y="8" width="2" height="32" fill="currentColor"/>
                  <rect x="2" y="12" width="44" height="2" fill="currentColor"/>
                  <rect x="2" y="36" width="44" height="2" fill="currentColor"/>
                </svg>
              </div>
              <h3>Fences & Gates</h3>
              <p>Cedar privacy fencing in side-by-side and board-on-board styles. Walk gates with steel posts.</p>
            </div>
            <div class="service-image">
              <Image 
                src={fenceBrick}
                alt="Wood fence installation"
                widths={[300, 400]}
                sizes="300px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          
          <div class="service">
            <h3>Fence Staining</h3>
            <p>Protect and refresh your wood fence with professional staining.</p>
          </div>
          
          <div class="service">
            <h3>Decks</h3>
            <p>Outdoor deck construction for San Antonio homes.</p>
          </div>
          
          <div class="service">
            <h3>Painting</h3>
            <p>Exterior painting services.</p>
          </div>
          
          <div class="service">
            <h3>Pressure Washing</h3>
            <p>Clean fences, decks, and exterior surfaces.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section projects" id="projects">
      <div class="container">
        <h2>Recent Projects</h2>
        <div class="gallery">
          <figure class="gallery-item gallery-large">
            <Image 
              src={fenceBackyard}
              alt="Wood privacy fence, San Antonio backyard"
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 60vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Wood privacy fence, San Antonio backyard</figcaption>
          </figure>
          
          <figure class="gallery-item gallery-portrait">
            <Image 
              src={fencePortrait}
              alt="Privacy fence along property line"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 30vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Privacy fence along property line</figcaption>
          </figure>
          
          <figure class="gallery-item">
            <Image 
              src={fenceTree}
              alt="Privacy fence installation with steel posts"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Privacy fence with steel posts</figcaption>
          </figure>
          
          <figure class="gallery-item">
            <Image 
              src={fenceBrick}
              alt="Wood fence beside brick house"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Wood fence installation</figcaption>
          </figure>
          
          <figure class="gallery-item">
            <Image 
              src={heroImg}
              alt="Privacy fence with walk gate"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Privacy fence with walk gate</figcaption>
          </figure>
          
          <figure class="gallery-item gallery-small">
            <Image 
              src={fenceDusk}
              alt="Fence installation"
              widths={[300, 480]}
              sizes="(max-width: 768px) 50vw, 20vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Fence installation</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section process" id="process">
      <div class="container">
        <h2>How it works</h2>
        <div class="process-grid">
          <div class="process-step">
            <div class="step-number">1</div>
            <h3>Call or send the form</h3>
            <p>Reach out by phone or fill out the quote form with your project details.</p>
          </div>
          
          <div class="process-step">
            <div class="step-number">2</div>
            <h3>On-site look and measurement</h3>
            <p>We visit your property to assess the job and take measurements.</p>
          </div>
          
          <div class="process-step">
            <div class="step-number">3</div>
            <h3>Written quote</h3>
            <p>You receive a clear quote for the work.</p>
          </div>
          
          <div class="process-step">
            <div class="step-number">4</div>
            <h3>Build and clean up</h3>
            <p>We install your fence and leave the site clean.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section area" id="area">
      <div class="container">
        <div class="area-grid">
          <div class="area-content">
            <h2>Serving San Antonio</h2>
            <p>Dylan's Fencing LLC is based in west San Antonio and serves neighborhoods throughout the city.</p>
            
            <div class="area-details">
              <div class="detail-block">
                <h3>Location</h3>
                <p>9626 Wolf Point<br>San Antonio, TX 78251</p>
              </div>
              
              <div class="detail-block">
                <h3>Hours</h3>
                <table class="hours-table">
                  <tr><td>Mon–Fri</td><td>8:00 AM – 7:00 PM</td></tr>
                  <tr><td>Saturday</td><td>9:00 AM – 5:00 PM</td></tr>
                  <tr><td>Sunday</td><td>Closed</td></tr>
                </table>
              </div>
            </div>
          </div>
          
          <div class="area-map">
            <div class="location-badge">
              <svg viewBox="0 0 200 120" fill="none">
                <rect width="200" height="120" fill="#303220" rx="2"/>
                <text x="100" y="45" text-anchor="middle" font-family="var(--font-display)" font-size="16" font-weight="700" fill="#c4ad84" letter-spacing="0.1em">WEST SAN ANTONIO</text>
                <text x="100" y="75" text-anchor="middle" font-family="var(--font-display)" font-size="24" font-weight="700" fill="#F4F1EA" letter-spacing="0.05em">78251</text>
                <line x1="40" y1="60" x2="160" y2="60" stroke="#7d6a47" stroke-width="1"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section quote" id="quote">
      <div class="container">
        <div class="quote-layout">
          <div class="quote-intro">
            <h2>Get a fence quote</h2>
            <p>Fill out the form and we'll get back to you. Or call directly:</p>
            <a href="tel:+12102605959" class="quote-phone">(210) 260-5959</a>
          </div>
          
          <form class="quote-form" id="quoteForm">
            <div class="form-row">
              <div class="form-field">
                <label for="name">Name <span class="required">*</span></label>
                <input type="text" id="name" name="name" required>
              </div>
              
              <div class="form-field">
                <label for="phone">Phone <span class="required">*</span></label>
                <input type="tel" id="phone" name="phone" required>
              </div>
            </div>
            
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email">
            </div>
            
            <div class="form-row">
              <div class="form-field">
                <label for="fenceType">Fence Type</label>
                <select id="fenceType" name="fenceType">
                  <option value="">Select one</option>
                  <option value="privacy">Privacy fence</option>
                  <option value="gate">Gate only</option>
                  <option value="staining">Fence staining</option>
                  <option value="other">Other</option>
                </select>
              </div>
              
              <div class="form-field">
                <label for="footage">Approx. linear footage</label>
                <input type="text" id="footage" name="footage" placeholder="e.g., 100 ft">
              </div>
            </div>
            
            <div class="form-field">
              <label for="address">Address or neighborhood</label>
              <input type="text" id="address" name="address">
            </div>
            
            <div class="form-field">
              <label for="notes">Project notes</label>
              <textarea id="notes" name="notes" rows="4"></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary btn-large">Send quote request</button>
            
            <div class="form-message" id="formMessage"></div>
            
            <noscript>
              <p class="form-noscript">This form requires JavaScript. Please call (210) 260-5959 to request a quote.</p>
            </noscript>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="wordmark">
            <div class="wordmark-main">DYLAN'S</div>
            <div class="wordmark-sub">FENCING LLC</div>
          </div>
          <p class="footer-tagline">We take pride in our work and prove it by offering some of the best workmanship around with prices you can't beat.</p>
        </div>
        
        <div class="footer-contact">
          <h3>Contact</h3>
          <p><a href="tel:+12102605959">(210) 260-5959</a></p>
          <p><a href="mailto:dylansfencing@gmail.com">dylansfencing@gmail.com</a></p>
          <p>9626 Wolf Point<br>San Antonio, TX 78251</p>
        </div>
        
        <div class="footer-hours">
          <h3>Hours</h3>
          <p>Mon–Fri: 8:00 AM – 7:00 PM<br>
             Saturday: 9:00 AM – 5:00 PM<br>
             Sunday: Closed</p>
        </div>
        
        <div class="footer-social">
          <h3>Follow</h3>
          <p><a href="https://www.facebook.com/p/Dylans-Fencing-LLC-100093611084668/" target="_blank" rel="noopener">Facebook</a></p>
          <p><a href="https://nextdoor.com/pages/goff-fencing-san-antonio-tx/" target="_blank" rel="noopener">Nextdoor</a></p>
        </div>
      </div>
      
      <div class="footer-bottom">
        <p class="footer-credits">Demo preview by <a href="https://zafe.dev" target="_blank" rel="noopener">Zafe</a> • Photos: Dylan's Fencing LLC (<a href="https://nextdoor.com/pages/goff-fencing-san-antonio-tx/" target="_blank" rel="noopener">Nextdoor</a>)</p>
      </div>
    </div>
  </footer>

  <style>
    .demo-bar {
      background: #303220;
      color: #F4F1EA;
      padding: 0.5rem 0;
      font-size: 0.875rem;
      text-align: center;
    }
    
    .demo-bar a {
      color: var(--color-cedar-light);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
    
    .demo-bar a:hover {
      color: #d4c49a;
    }
    
    @media (max-width: 500px) {
      .demo-bar-full {
        display: none;
      }
    }

    .header {
      background: #F4F1EA;
      padding: 1rem 0;
      border-bottom: 1px solid rgba(48, 50, 32, 0.1);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
    
    .wordmark {
      display: inline-block;
    }
    
    .wordmark-main {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      line-height: 1;
      color: var(--color-dark);
    }
    
    .wordmark-sub {
      font-family: var(--font-display);
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      color: var(--color-charcoal);
      margin-top: 0.125rem;
    }
    
    .nav {
      display: none;
      gap: 2rem;
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    
    .nav a {
      color: var(--color-dark);
      transition: color 0.2s;
    }
    
    .nav a:hover {
      color: var(--color-cedar);
    }
    
    .nav-cta {
      padding: 0.5rem 1rem;
      background: var(--color-cedar-dark);
      color: white;
      border-radius: 2px;
    }
    
    .nav-cta:hover {
      background: #6d5a37;
      color: white;
    }
    
    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .phone-link {
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--color-dark);
      white-space: nowrap;
    }
    
    .nav-toggle {
      display: flex;
      flex-direction: column;
      gap: 4px;
      background: none;
      padding: 0.5rem;
      border: none;
      z-index: 101;
    }
    
    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--color-dark);
      transition: all 0.3s;
    }
    
    @media (min-width: 768px) {
      .nav {
        display: flex;
        align-items: center;
      }
      
      .nav-toggle {
        display: none;
      }
    }
    
    @media (max-width: 767px) {
      .nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #F4F1EA;
        border-bottom: 1px solid rgba(48, 50, 32, 0.1);
        flex-direction: column;
        gap: 0;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      }
      
      .nav a {
        padding: 1rem 1.5rem;
        width: 100%;
        min-height: 48px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(48, 50, 32, 0.05);
      }
      
      .nav-cta {
        background: transparent;
        color: var(--color-dark);
        border-radius: 0;
      }
    }

    .hero {
      padding: 2rem 0 0;
    }
    
    .hero .container {
      display: grid;
      gap: 2rem;
      align-items: center;
    }
    
    .hero-content {
      padding: 1rem 0;
    }
    
    .hero h1 {
      margin-bottom: 1rem;
    }
    
    .hero-support {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
    }
    
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    
    .btn {
      display: inline-block;
      padding: 0.875rem 1.75rem;
      font-size: 1rem;
      letter-spacing: 0.02em;
      text-align: center;
      border-radius: 2px;
    }
    
    .btn-primary {
      background: var(--color-cedar-dark);
      color: white;
    }
    
    .btn-primary:hover {
      background: #6d5a37;
    }
    
    .btn-secondary {
      background: transparent;
      color: var(--color-dark);
      border: 2px solid var(--color-dark);
    }
    
    .btn-secondary:hover {
      background: var(--color-dark);
      color: white;
    }
    
    .btn-large {
      padding: 1rem 2rem;
      font-size: 1.125rem;
    }
    
    .hero-proof {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
    }
    
    .hero-proof a {
      color: var(--color-dark);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
    
    .hero-image {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: 2px;
    }
    
    .hero-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 35%;
    }
    
    .hero-divider {
      margin-top: 2rem;
      padding: 1.5rem 0;
    }
    
    .picket-line {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      gap: 1.5rem;
      justify-content: center;
    }
    
    .picket-line span {
      width: 2px;
      height: 32px;
      background: var(--color-charcoal);
      opacity: 0.3;
    }
    
    @media (min-width: 768px) {
      .hero {
        padding: 3rem 0 0;
      }
      
      .hero .container {
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
      }
      
      .hero-image {
        aspect-ratio: 4 / 3;
      }
    }
    
    @media (min-width: 1024px) {
      .hero {
        padding: 4rem 0 0;
      }
    }

    .services {
      background: white;
      padding: 2.5rem 0;
    }
    
    .services h2 {
      margin-bottom: 0.75rem;
    }
    
    .services-intro {
      font-size: 1.125rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
    }
    
    .services-grid {
      display: grid;
      gap: 2rem;
    }
    
    .service {
      padding: 1.5rem;
      border-left: 2px solid var(--color-cedar);
    }
    
    .service h3 {
      margin-bottom: 0.75rem;
    }
    
    .service-featured {
      background: #fafaf8;
      padding: 0;
      border: none;
      border-left: 4px solid var(--color-dark);
      display: grid;
      gap: 1.5rem;
    }
    
    .service-content {
      padding: 2rem;
    }
    
    .service-icon {
      color: var(--color-dark);
      margin-bottom: 1rem;
    }
    
    .service-image {
      overflow: hidden;
      border-radius: 0 0 2px 2px;
    }
    
    .service-image img {
      width: 100%;
      height: auto;
      object-fit: cover;
    }
    
    @media (min-width: 768px) {
      .services {
        padding: 3.5rem 0;
      }
      
      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .service-featured {
        grid-column: 1 / -1;
        grid-template-columns: 1fr 300px;
      }
    }
    
    @media (min-width: 1024px) {
      .services {
        padding: 4.5rem 0;
      }
      
      .services-grid {
        grid-template-columns: 2fr 1fr 1fr;
      }
      
      .service-featured {
        grid-column: 1;
        grid-row: 1 / 3;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr auto;
      }
    }

    .projects h2 {
      margin-bottom: 2rem;
    }
    
    .gallery {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(12, 1fr);
    }
    
    .gallery-item {
      position: relative;
      border-radius: 2px;
      overflow: hidden;
    }
    
    .gallery-item img {
      width: 100%;
      height: 250px;
      object-fit: cover;
    }
    
    .gallery-item figcaption {
      padding: 0.75rem;
      font-size: 0.875rem;
      color: var(--color-text-muted);
      background: #fafaf8;
    }
    
    .gallery-item {
